rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches("^[a-zA-Z0-9_\\-\\+]+$");
    }

    // Helper to get committee data
    function getCommittee(committeeId) {
      return get(/databases/$(database)/documents/committees/$(committeeId)).data;
    }

    // Comprehensive Admin Check
    function isAdmin(committeeId) {
      return isSignedIn() && (
        getCommittee(committeeId).adminUID == request.auth.uid ||
        (
          request.auth.token.phone_number != null && 
          exists(/databases/$(database)/documents/committees/$(committeeId)/members/$(request.auth.token.phone_number)) &&
          get(/databases/$(database)/documents/committees/$(committeeId)/members/$(request.auth.token.phone_number)).data.role == 'ADMIN'
        )
      );
    }
    
    // Comprehensive Member Check
    function isMemberOf(committeeId) {
      return isSignedIn() && (
        getCommittee(committeeId).adminUID == request.auth.uid ||
        (
          request.auth.token.phone_number != null && 
          exists(/databases/$(database)/documents/committees/$(committeeId)/members/$(request.auth.token.phone_number))
        )
      );
    }

    // Role-based Access Check
    function hasRole(committeeId, roles) {
      return isSignedIn() && (
        getCommittee(committeeId).adminUID == request.auth.uid ||
        (
          request.auth.token.phone_number != null && 
          exists(/databases/$(database)/documents/committees/$(committeeId)/members/$(request.auth.token.phone_number)) &&
          get(/databases/$(database)/documents/committees/$(committeeId)/members/$(request.auth.token.phone_number)).data.role in roles
        )
      );
    }

    // --- COLLECTIONS ---

    // Connection Test
    match /test/connection {
      allow read: if isSignedIn();
    }

    // Committees
    match /committees/{committeeId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && isValidId(committeeId);
      allow update, delete: if isAdmin(committeeId);

      // Members
      match /members {
        allow list: if isMemberOf(committeeId);
      }
      match /members/{memberId} {
        allow get: if isSignedIn() && (memberId == request.auth.token.phone_number || isMemberOf(committeeId));
        allow create: if isSignedIn() && isValidId(memberId);
        allow update, delete: if isAdmin(committeeId);
      }

      // Chanda Entries
      match /chandaEntries {
        allow list: if isMemberOf(committeeId);
      }
      match /chandaEntries/{entryId} {
        allow get: if isMemberOf(committeeId);
        allow create: if hasRole(committeeId, ['ADMIN', 'Chanda_Volunteer', 'Chanda_Incharge', 'Secretary'])
          && isValidId(entryId)
          && request.resource.data.amount is number;
        allow update: if hasRole(committeeId, ['ADMIN', 'Chanda_Incharge', 'Secretary'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt', 'updatedAt']);
        allow delete: if isAdmin(committeeId);
      }

      // Donations
      match /donations {
        allow list: if isMemberOf(committeeId);
      }
      match /donations/{entryId} {
        allow get: if isMemberOf(committeeId);
        allow create, update: if hasRole(committeeId, ['ADMIN', 'Donation_Incharge', 'Secretary'])
          && isValidId(entryId);
        allow delete: if isAdmin(committeeId);
      }

      // Expenses
      match /expenses {
        allow list: if isMemberOf(committeeId);
      }
      match /expenses/{entryId} {
        allow get: if isMemberOf(committeeId);
        allow create: if hasRole(committeeId, [
          'ADMIN', 'CASHIER', 'LIGHT_INCHARGE', 'PANDAL_INCHARGE', 'VISARJAN_INCHARGE', 'MANDAP_INCHARGE', 'SECRETARY'
        ]) && isValidId(entryId);
        
        allow update: if isAdmin(committeeId) 
          || (hasRole(committeeId, ['SECRETARY']))
          || (hasRole(committeeId, ['JOINT_SECRETARY']) && resource.data.role != 'CASHIER');
        
        allow delete: if isAdmin(committeeId);
      }

      // Broadcasts
      match /broadcasts {
        allow list: if isMemberOf(committeeId);
      }
      match /broadcasts/{docId} {
        allow get: if isMemberOf(committeeId);
        allow create: if hasRole(committeeId, ['ADMIN', 'SECRETARY', 'JOINT_SECRETARY'])
          && isValidId(docId);
        allow update, delete: if isAdmin(committeeId);
      }

      // Custom Categories
      match /customCategories {
        allow list: if isMemberOf(committeeId);
      }
      match /customCategories/{categoryId} {
        allow get: if isMemberOf(committeeId);
        allow create: if hasRole(committeeId, ['ADMIN', 'SECRETARY', 'JOINT_SECRETARY'])
          && isValidId(categoryId);
        allow delete: if isAdmin(committeeId);
      }

      // Custom Roles
      match /customRoles {
        allow list: if isMemberOf(committeeId);
      }
      match /customRoles/{roleId} {
        allow get: if isMemberOf(committeeId);
        allow create, update, delete: if isAdmin(committeeId) && isValidId(roleId);
      }

      // Puja Editions
      match /editions {
        allow list: if isMemberOf(committeeId);
      }
      match /editions/{editionId} {
        allow get: if isMemberOf(committeeId);
        allow create, update, delete: if isAdmin(committeeId) && isValidId(editionId);
      }

      // Edition Members (member roles per edition)
      match /editionMembers {
        allow list: if isMemberOf(committeeId);
      }
      match /editionMembers/{editionMemberId} {
        allow get: if isMemberOf(committeeId);
        allow create, update, delete: if isAdmin(committeeId) && isValidId(editionMemberId);
      }

      // Yearly Budget
      match /yearlyBudget {
        allow list: if isMemberOf(committeeId);
      }
      match /yearlyBudget/{budgetId} {
        allow get: if isMemberOf(committeeId);
        allow create: if hasRole(committeeId, ['ADMIN', 'SECRETARY', 'JOINT_SECRETARY'])
          && isValidId(budgetId)
          && request.resource.data.allocatedAmount is number
          && request.resource.data.year is number;
        allow update: if hasRole(committeeId, ['ADMIN', 'SECRETARY', 'JOINT_SECRETARY'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allocatedAmount', 'spentAmount', 'remainingAmount', 'notes']);
        allow delete: if isAdmin(committeeId);
      }

      // Generic Catch-all for sub-collections
      match /{subCollection}/{docId} {
        allow read: if isMemberOf(committeeId);
        allow create, update: if hasRole(committeeId, ['ADMIN', 'Secretary', 'Joint_Secretary', 'Light_Incharge', 'Pandal_Incharge', 'Visarjan_Incharge', 'Mandap_Incharge', 'Cultural_Incharge']);
        allow delete: if isAdmin(committeeId);
      }
    }

    // Global Audit Log
    match /auditLog/{logId} {
       allow read: if isSignedIn(); // Simplified for now to prevent O(n) get() failures
       allow create: if isSignedIn();
    }
  }
}
