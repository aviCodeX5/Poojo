{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samitibook",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-25",
  "observability": {
    "enabled": true
  },
  "routes": [
    "https://samitibook.mpcu.workers.dev/api/*"
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samitibook",
      "database_id": "3e1493a2-4817-4c25-9f6e-61faef0747b3"
    }
  ]
}
