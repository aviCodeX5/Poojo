rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidCommitteeId(committeeId) {
      return committeeId is string && committeeId.size() <= 128 && committeeId.matches("^[a-zA-Z0-9_\\-\\+]+$");
    }
    
    // Committee bill photos
    match /committees/{committeeId}/bills/{userId}/{fileName} {
      // The app stores committee membership in a named Firestore database.
      // Cloud Storage rules can only use firestore.get/exists against the default
      // database, so membership checks are enforced by Firestore before bill URLs
      // are attached to expense records.
      allow read: if isSignedIn() && isValidCommitteeId(committeeId);
      allow create, delete: if isSignedIn()
        && request.auth.uid == userId
        && isValidCommitteeId(committeeId);
    }
  }
}
