# GEMINI_API_KEY: Optional for Gemini AI / GenAI integrations.
# This app does not currently require it for Firebase auth or Firestore access.
# Keep it empty unless you add AI features that need the Gemini API.
GEMINI_API_KEY=""

# APP_URL: The final deployed URL for this app.
# For Cloudflare Pages, this is your Pages domain or custom domain.
# Example: https://my-puja-committee.pages.dev or https://app.example.com
APP_URL="https://your-app.pages.dev"

# Firebase client config for the web app. These values are safe to expose in frontend code.
# Use your project's free-tier Firestore database ID for no-cost demo hosting.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"

# Server-side media upload secret for Cloudflare Worker / Cloudinary.
# Do not expose this with a VITE_ prefix.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
