# APP_URL: The final deployed URL for this app.
# For Cloudflare Workers, this is your workers.dev or custom domain.
APP_URL="https://samitibook.example.com"

# Server-side media upload secret for Cloudflare Worker / Cloudinary.
# Do not expose this with a VITE_ prefix.
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Server-side email delivery for verification codes through Resend.
# Store RESEND_API_KEY as a Cloudflare Worker secret in production.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="SamitiBook <onboarding@resend.dev>"
